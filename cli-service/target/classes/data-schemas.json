  "work_order_page": {
    "name": "工单分页查询",
    "description": "分页查询工单列表",
    "inputSchema": {
      "pageNum": {"type": "Integer", "required": true, "description": "当前页数"},
      "pageSize": {"type": "Integer", "required": true, "description": "每页大小"},
